	If '$system.CLS.GetModified() Quit sc
	If m%Address Set iv=..Address If iv'="" Set rc=(..AddressIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"Address",iv)
	If m%Department Set iv=..Department If iv'="" Set rc=(..DepartmentIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"Department",iv)
	Set iv=..EmployeeId If iv="" Set rc=$$Error^%apiOBJ(5659,$classname()_"::EmployeeId("_$this_",ID="_..%Id()_")"),sc=$select(+sc:rc,1:$$AppendStatus^%occSystem(sc,rc))
	If m%EmployeeId Set rc=(..EmployeeIdIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"EmployeeId",iv)
	Set iv=..ID If iv="" Set rc=$$Error^%apiOBJ(5659,$classname()_"::ID("_$this_",ID="_..%Id()_")"),sc=$select(+sc:rc,1:$$AppendStatus^%occSystem(sc,rc))
	If m%ID Set rc=(..IDIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"ID",iv)
	If m%KanaName Set iv=..KanaName If iv'="" Set rc=(..KanaNameIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"KanaName",iv)
	Set iv=..Name If iv="" Set rc=$$Error^%apiOBJ(5659,$classname()_"::Name("_$this_",ID="_..%Id()_")"),sc=$select(+sc:rc,1:$$AppendStatus^%occSystem(sc,rc))
	If m%Name Set rc=(..NameIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"Name",iv)
	If m%PhoneNumber Set iv=..PhoneNumber If iv'="" Set rc=(..PhoneNumberIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"PhoneNumber",iv)
	If m%PostCode Set iv=..PostCode If iv'="" Set rc=(..PostCodeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"PostCode",iv)
	Set iv=..RetireFlg If iv="" Set rc=$$Error^%apiOBJ(5659,$classname()_"::RetireFlg("_$this_",ID="_..%Id()_")"),sc=$select(+sc:rc,1:$$AppendStatus^%occSystem(sc,rc))
	If m%RetireFlg Set rc=(..RetireFlgIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"RetireFlg",iv)
	If m%Sex Set iv=..Sex If iv'="" Set rc=(..SexIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"Sex",iv)
	Set iv=..deleteFlg If iv="" Set rc=$$Error^%apiOBJ(5659,$classname()_"::deleteFlg("_$this_",ID="_..%Id()_")"),sc=$select(+sc:rc,1:$$AppendStatus^%occSystem(sc,rc))
	If m%deleteFlg Set rc=(..deleteFlgIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"deleteFlg",iv)
	Set iv=..upDateTime If iv="" Set rc=$$Error^%apiOBJ(5659,$classname()_"::upDateTime("_$this_",ID="_..%Id()_")"),sc=$select(+sc:rc,1:$$AppendStatus^%occSystem(sc,rc))
	If m%upDateTime Set rc=(..upDateTimeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"upDateTime",iv)
	Quit sc }
